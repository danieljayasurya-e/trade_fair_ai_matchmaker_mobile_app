<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so the app can reach a teammate's laptop API on the LAN
     (e.g. http://192.168.1.20:4000) and the emulator host (10.0.2.2). Release builds keep HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
