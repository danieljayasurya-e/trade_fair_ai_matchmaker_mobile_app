# Copy to .env (git-ignored). react-native-config bakes these in at native build time,
# so rebuild after editing: npm run android (a Metro reload is not enough).

# Backend base URL. From a phone, use the laptop's LAN IP (same Wi-Fi), e.g. http://192.168.1.20:4000
# On the Android emulator, localhost is rewritten to 10.0.2.2 automatically.
API_URL=http://localhost:4000

# true = always use the built-in demo data. false = use the API, falling back to demo data if /api/health fails.
USE_MOCK=true
